# -----------------------------------------------------------------------------
# Reglas de asistencia del rol Docente (módulo Deporte PISU)
# -----------------------------------------------------------------------------
# Minutos antes del inicio de la clase en que se habilita "Llamar a lista".
ASISTENCIA_MINUTOS_ANTES=15
# Minutos después del fin de la clase en que se cierra la toma de asistencia.
ASISTENCIA_MINUTOS_DESPUES=120
# Modo de pruebas: si es true, se ignora la ventana horaria (aviso naranja).
ASISTENCIA_IGNORAR_HORARIO=false
# Porcentaje mínimo de asistencia para aprobar el deporte.
APROBACION_MIN_ASISTENCIA=80