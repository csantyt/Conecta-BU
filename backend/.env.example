PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/conecta_bu
JWT_SECRET=cambia_este_secreto
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_HOSTED_DOMAIN=uniautonoma.edu.co

# Asistente de IA (chat de orientación y recomendador de eventos).
# Orden de uso: proveedor de IA → n8n (si hay webhook) → reglas locales. Sin clave ni n8n, el chat sigue respondiendo con reglas.
# Clave gratuita de Gemini: https://aistudio.google.com/apikey
IA_API_KEY=
# Cualquier proveedor compatible con OpenAI. Por defecto Gemini:
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
IA_MODELO=gemini-3.5-flash-lite
# Groq:   IA_BASE_URL=https://api.groq.com/openai/v1   IA_MODELO=openai/gpt-oss-120b
# OpenAI: IA_BASE_URL=https://api.openai.com/v1        IA_MODELO=<modelo de OpenAI>
IA_TIMEOUT_MS=20000

# Webhooks de n8n (opcional, POST). Déjalos vacíos si no usas n8n.
N8N_WEBHOOK_ORIENTACION=
N8N_WEBHOOK_RECOMENDACIONES=
N8N_TIMEOUT_MS=20000
