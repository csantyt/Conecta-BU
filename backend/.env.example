# Dominio institucional autorizado (sección 10.1). Solo se aceptan correos cuyo
# dominio sea EXACTAMENTE este (sin espacios y sin distinguir mayúsculas);
# un subdominio o un dominio que solo contenga el texto (por ejemplo
# uniautonoma.edu.co.otrodominio.com) se rechazan. La validación definitiva la
# hace el servidor.
GOOGLE_HOSTED_DOMAIN=uniautonoma.edu.co

# Fechas del semestre académico (ISO). El punto medio determina el plazo para cancelar inscripciones.
SEMESTRE_INICIO=2026-01-01
